class Solution {
public:
    int numberOfSpecialChars(string word) {
        
        vector<int> lastOcc(26,INT_MAX);
        vector<int> firstOcc(26, INT_MIN);

        for(int i = 0 ; i < word.length(); i++) {

            if(word[i] >= 'a' && word[i] <= 'z') {
                lastOcc[word[i] - 'a'] = i;
            }
            else {
                if(firstOcc[word[i] - 'A'] == INT_MIN) {
                    firstOcc[word[i] - 'A'] = i;
                }
            }

        }

        int count = 0;

        for(int i = 0 ; i < 26 ; i++) {

            if(lastOcc[i] < firstOcc[i])
                count++;

        }

        return count;

    }
};
